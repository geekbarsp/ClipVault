<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="ClipVault_App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ClipVault">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Grid x:Name="WindowRoot">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Background="{ThemeResource ClipVaultPanelBrush}" BorderBrush="{ThemeResource ClipVaultBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="18">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="TitleBrandColumn" Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
   <VisualStateManager.VisualStateGroups>
    <VisualStateGroup x:Name="TitleBarResponsiveStates">
     <VisualState x:Name="WideTitleBar"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100"/></VisualState.StateTriggers></VisualState>
     <VisualState x:Name="MediumTitleBar">
      <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="700"/></VisualState.StateTriggers>
      <VisualState.Setters>
       <Setter Target="TitleBrandColumn.Width" Value="220"/>
       <Setter Target="BrandPanel.Margin" Value="18,0,0,0"/>
       <Setter Target="BrandSubtitle.Visibility" Value="Collapsed"/>
      </VisualState.Setters>
     </VisualState>
     <VisualState x:Name="NarrowTitleBar">
      <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
      <VisualState.Setters>
       <Setter Target="TitleBrandColumn.Width" Value="64"/>
       <Setter Target="BrandPanel.Margin" Value="12,0,0,0"/>
       <Setter Target="BrandTextPanel.Visibility" Value="Collapsed"/>
       <Setter Target="TitleSettingsButton.Visibility" Value="Collapsed"/>
       <Setter Target="TitleThemeButton.Visibility" Value="Collapsed"/>
       <Setter Target="TitleSearch.Margin" Value="2,0"/>
      </VisualState.Setters>
     </VisualState>
    </VisualStateGroup>
   </VisualStateManager.VisualStateGroups>
   <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0" Spacing="14"><Image Width="42" Height="42" Source="Assets/Brand/ClipVaultIcon.png" Stretch="Uniform" AutomationProperties.Name="ClipVault logo"/><StackPanel x:Name="BrandTextPanel" VerticalAlignment="Center"><TextBlock Text="ClipVault" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="BrandSubtitle" Text="Clipboard Manager" FontSize="12" Foreground="{ThemeResource ClipVaultMutedBrush}"/></StackPanel></StackPanel>
   <AutoSuggestBox x:Name="TitleSearch" Grid.Column="1" MaxWidth="680" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="42" Margin="10,0" PlaceholderText="Search copied items, tags, or content..." QueryIcon="Find" TextChanged="TitleSearch_TextChanged" CornerRadius="21"><AutoSuggestBox.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked"/></AutoSuggestBox.KeyboardAccelerators></AutoSuggestBox>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
    <Button x:Name="TitleSettingsButton" Style="{StaticResource IconButtonStyle}" Click="TitleSettings_Click" ToolTipService.ToolTip="Settings"><FontIcon Glyph="&#xE713;" FontSize="17"/></Button>
    <Button x:Name="TitleThemeButton" Style="{StaticResource IconButtonStyle}" Click="ThemeButton_Click" ToolTipService.ToolTip="Toggle light and dark theme"><FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="17"/></Button>
    <Button x:Name="PinButton" Style="{StaticResource IconButtonStyle}" Click="PinButton_Click" Width="42" Height="42" BorderThickness="1" BorderBrush="#287DC7" Background="#1687FF" ToolTipService.ToolTip="Always on Top: Disabled" AutomationProperties.Name="Toggle main window always on top"><FontIcon x:Name="PinIcon" Glyph="&#xE840;" FontSize="17" Foreground="White"/></Button>
   </StackPanel>
  </Grid>
  <Frame x:Name="RootFrame" Grid.Row="1" />
 </Grid>
</Window>
